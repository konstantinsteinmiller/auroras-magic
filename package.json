{
  "name": "auroras-magic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:playgama": "vite --mode playgama",
    "dev:poki": "vite --mode poki",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "build:web": "vite build --base=./ && node tools/pack/pack.mjs --platform=web",
    "build:crazy-web": "vite build --mode crazy-web --base=./ && node tools/pack/pack.mjs --platform=crazy-web",
    "build:poki": "vite build --mode poki --base=./ && node tools/pack/pack.mjs --platform=poki",
    "build:playgama": "vite build --mode playgama --base=./ && node tools/pack/pack.mjs --platform=playgama",
    "build:gamepix": "vite build --mode gamepix --base=./ && node tools/pack/pack.mjs --platform=gamepix",
    "build:gamemonetize": "vite build --mode gamemonetize --base=./ && node tools/pack/pack.mjs --platform=gamemonetize",
    "build:game-distribution": "vite build --mode game-distribution --base=./ && node tools/pack/pack.mjs --platform=game-distribution",
    "build:yandex": "vite build --mode yandex --base=./ && node tools/pack/pack.mjs --platform=yandex",
    "build:glitch": "vite build --mode glitch --base=./ && node tools/pack/pack.mjs --platform=glitch",
    "build:itch": "vite build --mode itch --base=./ && node tools/pack/pack.mjs --platform=itch",
    "build:wavedash": "vite build --mode wavedash --base=./ --outDir=wavedash-dist && node tools/pack/pack.mjs --platform=wavedash --dist=wavedash-dist --no-zip",
    "push:wavedash": "pnpm build:wavedash && wavedash build push",
    "build:all": "node tools/pack/build-all.mjs",
    "pack": "node tools/pack/pack.mjs",
    "deploy:poki": "node tools/poki-deploy/deploy.mjs",
    "build-github-main": "vite build --base=/auroras-magic/ --outDir=dist",
    "validated-build": "vue-tsc -b && vite build",
    "type-check": "vue-tsc --build",
    "perf:ab": "node scripts/perf-ab.mjs",
    "perf:builds": "node scripts/perf-builds.mjs",
    "qa:portal": "node scripts/portal-qa.mjs",
    "compress-folder": "node scripts/compress-images.mjs",
    "compress-bench": "node scripts/image-compress-bench.mjs",
    "compress-folder-with-backup": "node scripts/compress-images.mjs public/images --max-effort --backup-dir public-backup",
    "compress-promotion-with-backup": "node scripts/compress-images.mjs src/assets/promotion --max-effort --backup-dir src/assets/promotion-backup",
    "art:export": "node tools/export-sheets.mjs",
    "slice-sheets": "node tools/slice-sheets.mjs",
    "art:prompts": "node --import ./tools/ts-resolve.mjs tools/art-prompts.mjs",
    "art:models": "node tools/art-models.mjs",
    "art:status": "node --import ./tools/ts-resolve.mjs tools/art-status.mjs",
    "art:measure": "python tools/measure-art.py",
    "art:desk": "node tools/art-desk/server.mjs",
    "preview:video": "node tools/preview-video/record.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@playgama/bridge": "^2.2.0",
    "vue": "^3.5.29",
    "vue-i18n": "^11.2.8",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@gfx/zopfli": "^1.0.15",
    "@intlify/unplugin-vue-i18n": "^11.0.7",
    "@napi-rs/image": "^1.14.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.11.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/language-plugin-pug": "^3.2.5",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "fflate": "^0.8.3",
    "ffmpeg-static": "^5.3.0",
    "html-minifier-terser": "^7.2.0",
    "jsdom": "^28.1.0",
    "npm-run-all2": "^8.0.4",
    "playwright-core": "^1.63.0",
    "pug": "^3.0.3",
    "sass": "^1.97.3",
    "sharp": "^0.35.4",
    "ssim.js": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "terser": "^5.50.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-javascript-obfuscator": "^3.1.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.2.5"
  },
  "engines": {
    "node": "^25.5.0 || >=22.12.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "ffmpeg-static"
    ]
  },
  "description": "Auroras Magic — draw runes to duel a dark unicorn. Vue 3 + Vite + pug + Tailwind, built for every major web-game portal."
}
